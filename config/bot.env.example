WEBUI_BIND=127.0.0.1
QQ_ACCOUNT=
DEEPSEEK_BASE_URL=https://api.example.com/v1
DEEPSEEK_MODEL=your-chat-model
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
# Empty lists allow all private contacts, or all groups that @ the bot/use /ai.
ALLOWED_USERS=
ALLOWED_GROUPS=
ARCHIVE_DEFAULT_CAPTURE=1
ENABLED_PLUGINS=web_search,web_read,current_time
# Optional: add wikipedia_search if the server can reach its source.
READ_ALLOWED_DOMAINS=api-docs.deepseek.com,www.deepseek.com,docs.python.org,www.python.org,github.com,zh.wikipedia.org,en.wikipedia.org
# After initial pull, pin NAPCAT_IMAGE to the tested digest.
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# Optional capabilities use the same runtime entrypoint.
YUNZAI_ENABLED=0
MEMORY_ENABLED=0

# Qzone: only explicit private commands from these verified QQ accounts can publish.
SOCIAL_ENABLED=0
SOCIAL_ADMINS=
# 1=everyone, 4=friends, 64=only self. No random publication scheduler.
SOCIAL_VISIBILITY=4
SOCIAL_REPLIES=1
SOCIAL_REPOSTS=1

# Optional private customization; do not commit the resulting .env.
SYSTEM_PROMPT=
